[Unit]
Description=ormad, orma's eBPF probe daemon

[Service]
ExecStart=/usr/local/sbin/ormad
User=orma
Group=orma
# Each capability and why: design 5.1. CAP_SYS_ADMIN stays: this kernel's uprobe
# perf_event_open refused ormad without it (Ubuntu 7.0, 2026-10-11).
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
NoNewPrivileges=true
RuntimeDirectory=orma
Restart=on-failure
# Sandboxing (design 5.1). Not ProtectProc=invisible or ProcSubset=pid: ormad reads other
# users' /proc/<pid>/maps and root.
ProtectSystem=strict
PrivateTmp=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service bpf perf_event_open
SystemCallErrorNumber=EPERM
# Before 5.11 the kernel charges map memory to RLIMIT_MEMLOCK.
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
