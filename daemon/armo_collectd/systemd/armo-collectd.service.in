[Unit]
Description=armo-collectd, armo's per-user collector and recorder

[Service]
ExecStart=@CMAKE_INSTALL_PREFIX@/bin/armo-collectd
# The guard cleans up after armo-collectd dies and ends at end of input; the session daemon
# ends with armo-collectd. Killing the whole cgroup would take the guard down before it cleans.
KillMode=process

[Install]
WantedBy=default.target
