[Unit]
Description=armod, armo's eBPF probe daemon

[Service]
ExecStart=/usr/local/sbin/armod
User=armo
Group=armo
# Each capability and why: design 5.1. armod gives up CAP_SYS_ADMIN once it holds the
# BPF_ENABLE_STATS fd.
AmbientCapabilities=CAP_BPF CAP_PERFMON CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
NoNewPrivileges=true
RuntimeDirectory=armo
Restart=on-failure
# Sandboxing (design 5.1). Not ProtectProc=invisible or ProcSubset=pid: armod reads other
# users' /proc/<pid>/maps and root.
ProtectSystem=strict
PrivateTmp=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service bpf perf_event_open
SystemCallErrorNumber=EPERM
# Before 5.11 the kernel charges map memory to RLIMIT_MEMLOCK.
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
