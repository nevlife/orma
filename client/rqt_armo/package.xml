<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rqt_armo</name>
  <version>0.0.0</version>
  <description>
    The armo GUI: an rqt plugin and client of armo-collectd for monitoring, recordings and the
    message flow graph.
  </description>
  <maintainer email="nevlife000720@gmail.com">nevlife</maintainer>
  <license>MIT</license>

  <exec_depend>armo_cli</exec_depend>
  <exec_depend>python_qt_binding</exec_depend>
  <exec_depend>qt_dotgraph</exec_depend>
  <exec_depend>rqt_graph</exec_depend>
  <exec_depend>rqt_gui</exec_depend>
  <exec_depend>rqt_gui_py</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
    <rqt_gui plugin="${prefix}/plugin.xml"/>
  </export>
</package>
