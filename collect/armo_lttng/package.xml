<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>armo_lttng</name>
  <version>0.0.0</version>
  <description>
    The LTTng backend of armo, libarmo_lttng.so, loaded with LD_PRELOAD: armo_preload's interception
    code with LTTng-UST providers armo, flux and, where libtracetools has no LTTng, ros2.
  </description>
  <maintainer email="nevlife000720@gmail.com">nevlife</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>pkg-config</buildtool_depend>

  <build_depend>armo_preload</build_depend>
  <build_depend>tracetools</build_depend>
  <depend>liblttng-ust-dev</depend>

  <test_depend>ament_cmake_test</test_depend>
  <test_depend>armo_rclpy</test_depend>
  <test_depend>armo_span</test_depend>
  <test_depend>babeltrace</test_depend>
  <test_depend>flux_ffi</test_depend>
  <test_depend>lttng-tools</test_depend>
  <test_depend>rclcpp</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>std_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
